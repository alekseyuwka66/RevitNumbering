<Window x:Class="RevitNumbering.UI.Views.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RevitNumbering.UI.Resources"
        Title="{x:Static res:Texts.SummaryTitle}"
        Width="560" SizeToContent="Height" MaxHeight="600" MinWidth="380" MinHeight="220"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom" Content="{x:Static res:Texts.ButtonClose}" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" MinWidth="90" Padding="12,3" Margin="0,12,0,0" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding WrittenText}" TextWrapping="Wrap" FontSize="14"
                   FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding NotWrittenText}" TextWrapping="Wrap" Margin="0,10,0,4"
                   Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}" />

        <ListBox ItemsSource="{Binding Failures}" MinHeight="40"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}" />
    </DockPanel>
</Window>
