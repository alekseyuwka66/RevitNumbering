<UserControl x:Class="RevitNumbering.UI.Views.GridOrderingEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:res="clr-namespace:RevitNumbering.UI.Resources"
             xmlns:views="clr-namespace:RevitNumbering.UI.Views"
             xmlns:orderings="clr-namespace:RevitNumbering.Core.Orderings;assembly=RevitNumbering.Core">
    <!-- Bound directly to the GridOrdering object. NotifyOnSourceUpdated lets the settings panel
         see every change and recalculate the numbers. -->
    <StackPanel>
        <TextBlock Text="{x:Static res:Texts.LabelCorner}" />
        <ComboBox Margin="0,4,0,0" SelectedValuePath="Tag"
                  SelectedValue="{Binding Start, NotifyOnSourceUpdated=True}">
            <ComboBoxItem Content="{x:Static res:Texts.Corner_TopLeft}" Tag="{x:Static orderings:Corner.TopLeft}" />
            <ComboBoxItem Content="{x:Static res:Texts.Corner_TopRight}" Tag="{x:Static orderings:Corner.TopRight}" />
            <ComboBoxItem Content="{x:Static res:Texts.Corner_BottomLeft}" Tag="{x:Static orderings:Corner.BottomLeft}" />
            <ComboBoxItem Content="{x:Static res:Texts.Corner_BottomRight}" Tag="{x:Static orderings:Corner.BottomRight}" />
        </ComboBox>

        <TextBlock Text="{x:Static res:Texts.LabelDirection}" Margin="0,8,0,0" />
        <ComboBox Margin="0,4,0,0" SelectedValuePath="Tag"
                  SelectedValue="{Binding ByColumns, NotifyOnSourceUpdated=True}">
            <ComboBoxItem Content="{x:Static res:Texts.DirectionRows}">
                <ComboBoxItem.Tag>
                    <sys:Boolean>False</sys:Boolean>
                </ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="{x:Static res:Texts.DirectionColumns}">
                <ComboBoxItem.Tag>
                    <sys:Boolean>True</sys:Boolean>
                </ComboBoxItem.Tag>
            </ComboBoxItem>
        </ComboBox>

        <TextBlock Text="{x:Static res:Texts.LabelRowTolerance}" Margin="0,8,0,0" />
        <TextBox Margin="0,4,0,0">
            <TextBox.Text>
                <Binding Path="RowToleranceMm" UpdateSourceTrigger="PropertyChanged" NotifyOnSourceUpdated="True">
                    <Binding.ValidationRules>
                        <views:IntRangeRule Min="1" Max="100000" />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        <TextBlock Text="{x:Static res:Texts.RowToleranceHint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                   Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
