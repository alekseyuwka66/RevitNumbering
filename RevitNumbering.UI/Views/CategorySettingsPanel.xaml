<UserControl x:Class="RevitNumbering.UI.Views.CategorySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RevitNumbering.UI.Resources"
             xmlns:views="clr-namespace:RevitNumbering.UI.Views"
             xmlns:orderings="clr-namespace:RevitNumbering.Core.Orderings;assembly=RevitNumbering.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Editors of ordering strategies are chosen by the type of the strategy object.
             A new strategy = its editor + one line here. -->
        <DataTemplate DataType="{x:Type orderings:GridOrdering}">
            <views:GridOrderingEditor />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,0">
            <!-- Template -->
            <TextBlock Text="{x:Static res:Texts.LabelTemplate}" FontWeight="SemiBold" />
            <TextBox Margin="0,4,0,0" Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{x:Static res:Texts.TemplateHint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#C00000" Margin="0,6,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="#B36B00" Margin="0,6,0,0"
                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />

            <!-- Level code -->
            <TextBlock Text="{x:Static res:Texts.LabelLevelCode}" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ComboBox Margin="0,4,0,0" ItemsSource="{Binding LevelParts}" DisplayMemberPath="Title"
                      SelectedItem="{Binding SelectedLevelPart}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                        Visibility="{Binding IsWordNumberVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Static res:Texts.LabelWordNumber}" VerticalAlignment="Center" />
                <TextBox Width="50" Margin="8,0,0,0">
                    <TextBox.Text>
                        <Binding Path="WordNumber" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <views:IntRangeRule Min="1" Max="99" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </StackPanel>
            <TextBlock Text="{x:Static res:Texts.LevelCodeHint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                       Margin="0,4,0,0" />

            <!-- Ordering: the list of strategies and the editor of the chosen one -->
            <TextBlock Text="{x:Static res:Texts.LabelOrdering}" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Orderings}" DisplayMemberPath="Title"
                      SelectedItem="{Binding SelectedOrdering}" />
            <ContentControl Margin="0,8,0,0" Focusable="False" Content="{Binding Ordering}"
                            Binding.SourceUpdated="OnEditorSourceUpdated" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
