<UserControl x:Class="RevitNumbering.UI.Views.CategorySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RevitNumbering.UI.Resources"
             xmlns:views="clr-namespace:RevitNumbering.UI.Views"
             xmlns:orderings="clr-namespace:RevitNumbering.Core.Orderings;assembly=RevitNumbering.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type orderings:GridOrdering}">
            <views:GridOrderingEditor />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,0">
            <TextBlock Text="{x:Static res:Texts.LabelTemplate}" FontWeight="SemiBold" />
            <Grid Margin="0,6,0,0">
                <Grid.Resources>
                    <Style x:Key="Input" TargetType="TextBox">
                        <Setter Property="Height" Value="24" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource Input}" />
                    <Style x:Key="Caption" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Foreground" Value="Gray" />
                        <Setter Property="Margin" Value="0,0,4,2" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="50" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="50" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Texts.LabelPrefix}" Style="{StaticResource Caption}" />
                <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,4,0"
                         Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged, Delay=50}" />

                <TextBlock Text="{x:Static res:Texts.LabelLevel}" Grid.Row="0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Grid.Column" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LevelFirst}" Value="False">
                                    <Setter Property="Grid.Column" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <CheckBox Grid.Row="1" Margin="0,0,4,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsChecked="{Binding IncludeLevel}">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Grid.Column" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LevelFirst}" Value="False">
                                    <Setter Property="Grid.Column" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static res:Texts.LabelSeparator}" Style="{StaticResource Caption}" />
                <TextBox Grid.Row="1" Grid.Column="2" Width="44" Margin="0,0,4,0" IsEnabled="{Binding IncludeLevel}"
                         Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged, Delay=50}" />

                <TextBlock Grid.Row="0" Text="{x:Static res:Texts.LabelWidth}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Grid.Column" Value="3" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LevelFirst}" Value="False">
                                    <Setter Property="Grid.Column" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox Grid.Row="1" Width="28" MaxLength="1" TextAlignment="Center" Margin="0,0,4,0"
                         ToolTip="{x:Static res:Texts.HintWidth}" PreviewTextInput="OnWidthTextInput"
                         DataObject.Pasting="OnWidthPasting">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource Input}">
                            <Setter Property="Grid.Column" Value="3" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LevelFirst}" Value="False">
                                    <Setter Property="Grid.Column" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.Text>
                        <Binding Path="Width" UpdateSourceTrigger="PropertyChanged" Delay="50">
                            <Binding.ValidationRules>
                                <views:IntRangeRule Min="1" Max="9" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="{x:Static res:Texts.LabelSuffix}" Style="{StaticResource Caption}" />
                <TextBox Grid.Row="1" Grid.Column="4"
                         Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged, Delay=50}" />
            </Grid>

            <Button Content="{x:Static res:Texts.ButtonSwap}" Command="{Binding SwapCommand}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,2" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{x:Static res:Texts.LabelExample}" Foreground="Gray" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Example}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#C00000" Margin="0,6,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="#B36B00" Margin="0,6,0,0"
                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{x:Static res:Texts.LabelOrdering}" FontWeight="SemiBold" Margin="0,16,0,0" />
            <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Orderings}" DisplayMemberPath="Title"
                      SelectedItem="{Binding SelectedOrdering}" />
            <ContentControl Margin="0,8,0,0" Focusable="False" Content="{Binding Ordering}"
                            Binding.SourceUpdated="OnEditorSourceUpdated" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
