<Window x:Class="RevitNumbering.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RevitNumbering.UI.Resources"
        xmlns:views="clr-namespace:RevitNumbering.UI.Views"
        Title="{x:Static res:Texts.WindowTitle}"
        Width="1200" Height="700" MinWidth="900" MinHeight="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8" IsEnabled="{Binding CanEdit}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static res:Texts.LabelCategory}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Width="150" Margin="6,0,16,0"
                          ItemsSource="{Binding Categories}" DisplayMemberPath="Title"
                          SelectedItem="{Binding SelectedCategory}" />
                <TextBlock Grid.Column="2" Text="{Binding ScopeText}" VerticalAlignment="Center" Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ScopeText}" />
                <Button Grid.Column="3" Content="{x:Static res:Texts.ButtonPick}"
                        Command="{Binding PickCommand}" IsEnabled="{Binding CanPick}" />
                <Button Grid.Column="4" Content="{x:Static res:Texts.ButtonResetPick}" Margin="0"
                        Command="{Binding ResetPickCommand}" IsEnabled="{Binding HasPick}" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <views:ElementsTable Grid.Column="0" />
                <DockPanel Grid.Column="1" Margin="10,0,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,4,14" IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="{x:Static res:Texts.LabelSearch}" FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,0" Height="24" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=50}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="SearchMode" VerticalAlignment="Center"
                                         Margin="0,0,16,0" Content="{x:Static res:Texts.SearchAllTable}"
                                         IsChecked="{Binding IsSearchAll}" />
                            <RadioButton Grid.Column="1" GroupName="SearchMode" VerticalAlignment="Center"
                                         Margin="0,0,8,0" Content="{x:Static res:Texts.SearchByColumn}"
                                         IsChecked="{Binding IsSearchByColumn}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding SearchColumns}" DisplayMemberPath="Title"
                                      SelectedItem="{Binding SelectedSearchColumn}"
                                      IsEnabled="{Binding IsSearchByColumn}" />
                        </Grid>
                    </StackPanel>
                    <views:CategorySettingsPanel DataContext="{Binding Settings}"
                                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DockPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="{x:Static res:Texts.ButtonRefresh}"
                            Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}"
                            Visibility="{Binding IsRefreshVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{x:Static res:Texts.ButtonApply}" MinWidth="110"
                            Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" />
                    <Button Content="{x:Static res:Texts.ButtonCancel}" MinWidth="110" Margin="0"
                            Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
