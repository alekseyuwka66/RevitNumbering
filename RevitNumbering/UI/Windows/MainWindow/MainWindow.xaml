<Window x:Class="RevitNumbering.UI.Windows.MainWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:RevitNumbering.UI.Windows.MainWindow"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
        Width="800" Height="450">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding StatusText}" Margin="0,0,0,8"/>
        <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Padding="12,4"/>
    </StackPanel>
</Window>
