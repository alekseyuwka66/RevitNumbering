<Project>
	<PropertyGroup>
		<Version>1.0.0.0</Version>
		<Copyright>Copyright ©  2026</Copyright>
		<Company>RevitNumbering</Company>
		<Product>RevitNumbering</Product>

		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
	</PropertyGroup>

	<!-- Developer tools (ADR-03): msbuild /p:DevTools=true defines DEVTOOLS in every project -->
	<PropertyGroup Condition="'$(DevTools)' == 'true'">
		<DefineConstants>$(DefineConstants);DEVTOOLS</DefineConstants>
	</PropertyGroup>
</Project>
